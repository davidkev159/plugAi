# Copy this file to .env and fill in real values. Never commit .env.

# Composio API key — sign up free at https://composio.dev, then
# Dashboard > Settings > API Keys.
COMPOSIO_API_KEY=

# Anthropic API key (used to drive the research agent's tool loop) —
# get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: which Claude model to use for the agent loop.
RESEARCH_MODEL=claude-sonnet-5
